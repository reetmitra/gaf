# Key names only. Never commit values.
# The offline path (mock clients + lexical embedding fallback) needs NONE of these.
# They are read only when RunConfig.offline is False.

OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override the on-disk LLM response cache location (default: .gaf_cache/)
# GAF_CACHE_DIR=

# Optional: models served on this machine (--live --profile profiles/local-ollama.json).
# Default is Ollama at http://localhost:11434/v1. A non-loopback host is refused unless
# GAF_LOCAL_ALLOW_REMOTE=1, because that would send respondent text off the machine.
# GAF_LOCAL_BASE_URL=
# GAF_LOCAL_ALLOW_REMOTE=
# Bearer token for a remote OpenAI-compatible host reached under GAF_LOCAL_ALLOW_REMOTE=1.
# (For a hosted model, prefer provider "openai_compatible" below: its runs are not labelled local.)
# GAF_LOCAL_API_KEY=

# Optional: a HOSTED OpenAI-compatible model, provider "openai_compatible" (ADR-0052),
# e.g. coder B in profiles/opus-qwen.json. Respondent text goes to this host, so there is
# no default: set both, https only. Preferred host, Alibaba Cloud Model Studio
# international (Singapore; verify the region on your account):
#   https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Fallback, OpenRouter (model ids there carry a maker prefix, e.g. qwen/...):
#   https://openrouter.ai/api/v1
# GAF_COMPAT_BASE_URL=
# GAF_COMPAT_API_KEY=
# On by default: asks the host to switch a hybrid Qwen model's thinking off
# ("enable_thinking": false). Set to 0 only if the host rejects unknown fields.
# GAF_COMPAT_THINKING_OFF=
