# ---------------------------------------------------------------------------
# Human survey responses must NEVER enter git history.
# The exception list below is deliberately narrow: only data/synthetic/ ships.
# ---------------------------------------------------------------------------
data/*
!data/synthetic/
!data/synthetic/**

# Real-data extensions, wherever they land
*.xlsx
*.xlsm
*.docx
*.csv
*.tsv
!tests/fixtures/**/*.csv

# Runtime artefacts
runs/
# The PI's manual placements (highlight id -> response id). Ids only, no text, but they
# are his answers about his own data: kept local, normally under runs/ (ADR-0050). The
# rulings file he reads and may overrule (rulings/india-process.json) IS tracked.
manual-placements*.json
rulings/*.local.json
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
.gaf_cache/

# Secrets
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# OS / editor
.DS_Store
.idea/
.vscode/
